{
  "name": "personal-newspaper",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first personalized newspaper and knowledge collection platform.",
  "workspaces": [
    "apps/api",
    "packages/contracts",
    "packages/ai-gateway"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm --workspace @personal-newspaper/api run start:dev",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}

